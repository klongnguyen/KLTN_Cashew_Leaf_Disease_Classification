# ==========================================
# Git Ignore Configuration
# ==========================================

# Dataset / archives
dataset/
datasets/
data/
*.zip
*.tar
*.gz
*.rar
*.7z

# Large model / checkpoint artifacts
*.keras
*.h5
*.pt
*.pth
*.onnx
*.tflite
*.ckpt
*.pb
*.weights
runs/
wandb/
mlruns/

# Documents / reports generated outside repo
*.docx
*.doc
~$*.doc*
*.pdf
*.ppt
*.pptx
~$*.ppt*
*.xlsx
# Python / notebook
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.venv-web/
.uv-cache/
.uv-python/
.deit_v05_dataset/
.pytest_cache/
.mypy_cache/
analysis/source_024/
analysis_results/

# Temporary logs / caches
*.tmp
*.temp
*.log

# OS / IDE
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Weights of the deployed model (EXP-035) are tracked so a fresh clone can run the web app
!EXP-DENSENET121-YOLO-COMBINED-TRAINING-035-NEGV04/pipeline_bundle/best.pt
!EXP-DENSENET121-YOLO-COMBINED-TRAINING-035-NEGV04/pipeline_bundle/seed_*/deployment_model.keras
