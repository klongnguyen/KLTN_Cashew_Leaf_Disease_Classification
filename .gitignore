# ==========================================
# Git Ignore Configuration
# ==========================================

# Dataset / archives
dataset/
datasets/
data/
*.zip
*.tar
*.gz
*.rar
*.7z

# Large model / checkpoint artifacts
*.keras
*.h5
*.pt
*.pth
*.onnx
*.tflite
*.ckpt
*.pb
*.weights
runs/
wandb/
mlruns/

# Documents / reports generated outside repo
*.docx
*.doc
~$*.doc*
*.pdf
*.ppt
*.pptx
~$*.ppt*
*.xlsx
# Python / notebook
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.venv-web/
.uv-cache/
.uv-python/
.deit_v05_dataset/
.pytest_cache/
.mypy_cache/
analysis/source_024/
analysis_results/

# Temporary logs / caches
*.tmp
*.temp
*.log

# OS / IDE
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/

# Notebooks: ignored by default, only the listed ones are tracked
Notebook/**/*.ipynb
!Notebook/DenseNet121/densenet121_yolo_combined_training_034.ipynb
!Notebook/DenseNet121/densenet121_yolo_combined_training_035_negv04.ipynb
!Notebook/DenseNet121/densenet121_yolo_presence_036.ipynb
