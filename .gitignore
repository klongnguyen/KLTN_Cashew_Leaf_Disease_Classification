# ==========================================
# Git Ignore Configuration
# ==========================================

# Dataset / archives
dataset/
datasets/
data/
*.zip
*.tar
*.gz
*.rar
*.7z

# Large model / checkpoint artifacts
*.keras
*.h5
*.pt
*.pth
*.onnx
*.tflite
*.ckpt
*.pb
*.weights
runs/
wandb/
mlruns/

# Documents / reports generated outside repo
*.docx
*.doc
~$*.doc*
*.pdf
*.ppt
*.pptx
~$*.ppt*

# Python / notebook
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/

# Temporary logs / caches
*.tmp
*.temp
*.log

# OS / IDE
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
